{
  "functions": {
    "api/ssr.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/sitemap",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/review/:slug*",
      "destination": "/api/ssr?path=/review/:slug*"
    },
    {
      "source": "/compare/:slug*",
      "destination": "/api/ssr?path=/compare/:slug*"
    },
    {
      "source": "/privacy",
      "destination": "/api/ssr?path=/privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/ssr?path=/terms"
    },
    {
      "source": "/affiliate-disclosure",
      "destination": "/api/ssr?path=/affiliate-disclosure"
    },
    {
      "source": "/about",
      "destination": "/api/ssr?path=/about"
    },
    {
      "source": "/contact",
      "destination": "/api/ssr?path=/contact"
    },
    {
      "source": "/editorial-policy",
      "destination": "/api/ssr?path=/editorial-policy"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).+)",
      "destination": "/api/ssr?path=/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/sitemap-main.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/sitemap_index.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/faq-manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
